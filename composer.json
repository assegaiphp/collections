{
    "name": "assegaiphp/collections",
    "description": "Typed collection, list, set, queue, and stack primitives for modern PHP applications.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Assegai\\Collections\\": "src/"
        },
        "files": [
            "src/Util/Functions.php"
        ]
    },
    "authors": [
        {
            "name": "Andrew Masiye",
            "email": "andrew.masiye@assegaiphp.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "require-dev": {
        "pestphp/pest": "^4.4"
    }
}
